# NSCAS: templat variabel lingkungan PRODUKSI (DigitalOcean, wilayah Singapura sgp1).
#
# Cara pakai di Droplet:
#   cp deploy/digitalocean/.env.production.example /opt/nscas/.env
#   chmod 600 /opt/nscas/.env
#   nano /opt/nscas/.env
#
# Aturan:
# 1. Berkas ini hanya templat. Nilai rahasia sengaja dikosongkan dan hanya diisi di /opt/nscas/.env pada server.
# 2. Jangan pernah mengomit berkas yang sudah berisi rahasia, dan jangan mengirimkannya lewat surel atau obrolan.
# 3. Simpan salinan nilai rahasia di pengelola kata sandi perusahaan.
# 4. Tulis nilai tanpa tanda kutip dan tanpa spasi di sekitar tanda sama dengan.
# 5. Buat kata sandi dengan `openssl rand -hex 32` agar tidak memuat karakter khusus seperti tanda dolar.
# 6. Setelah mengubah berkas ini, jalankan ulang `deploy/digitalocean/deploy.sh deploy` agar kontainer memuatnya.

# ---------------------------------------------------------------------------------------------------------------------
# Aplikasi
# ---------------------------------------------------------------------------------------------------------------------
APP_NAME=NSCAS
APP_ENV=production
APP_DEBUG=false

# Kunci enkripsi Laravel (sesi, cookie, rahasia verifikasi dua langkah). RAHASIA.
# Buat satu kali dengan: echo "base64:$(openssl rand -base64 32)"
# Bila kunci ini hilang atau diganti, semua sesi berakhir dan rahasia verifikasi dua langkah tidak dapat dibuka.
# Pada tata letak C, semua server aplikasi wajib memakai kunci yang sama.
APP_KEY=

# Alamat publik lengkap dengan https, tanpa garis miring di akhir. Contoh: https://nscas.nusasafety.co.id
APP_URL=

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
BCRYPT_ROUNDS=12

# Mode pemeliharaan disimpan di basis data agar berlaku di semua server aplikasi sekaligus.
APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=database

# Lokasi penyimpanan data yang ditampilkan pada teks persetujuan responden (docs/04).
NSCAS_DATA_LOCATION=Singapura

# ---------------------------------------------------------------------------------------------------------------------
# Server web (FrankenPHP) dan tata letak
# ---------------------------------------------------------------------------------------------------------------------
# Tata letak A dan B (satu Droplet, TLS otomatis): isi dengan nama domain saja, tanpa https.
#   Contoh: nscas.nusasafety.co.id
# Tata letak C (di belakang DigitalOcean Load Balancer yang memegang TLS): isi dengan :8080
SERVER_NAME=

# Alamat proksi yang dipercaya untuk membaca header X-Forwarded-*.
# Tata letak A dan B: kosongkan, karena tidak ada proksi di depan aplikasi.
# Tata letak C: isi dengan rentang alamat VPC tempat Load Balancer berada, misalnya 10.104.0.0/20.
#   Beberapa rentang dipisahkan koma tanpa spasi. Jangan mengisi tanda bintang.
TRUSTED_PROXIES=

# Profil compose. Isi "single" hanya pada tata letak A (PostgreSQL di dalam Droplet).
# Kosongkan pada tata letak B dan C (DigitalOcean Managed PostgreSQL).
COMPOSE_PROFILES=

# Opsional. Jumlah utas PHP FrankenPHP, contoh: num_threads 16
# Ubah hanya berdasarkan hasil uji beban (docs/08 bagian ukuran server).
# FRANKENPHP_CONFIG=

# ---------------------------------------------------------------------------------------------------------------------
# Log
# ---------------------------------------------------------------------------------------------------------------------
# Log ditulis ke stderr dan ditampung Docker (dirotasi otomatis), bukan ke berkas di dalam kontainer.
LOG_CHANNEL=stderr
LOG_LEVEL=info

# ---------------------------------------------------------------------------------------------------------------------
# Basis data PostgreSQL 16
# ---------------------------------------------------------------------------------------------------------------------
DB_CONNECTION=pgsql

# Tata letak A: DB_HOST=postgres, DB_PORT=5432, DB_SSLMODE=prefer.
# Tata letak B dan C: host, port (biasanya 25060), nama basis data, dan pengguna dari halaman
#   Connection Details Managed PostgreSQL. Pakai alamat jaringan privat (VPC), bukan alamat publik.
DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=

# Kata sandi basis data. RAHASIA.
DB_PASSWORD=

# Managed PostgreSQL mewajibkan sambungan terenkripsi.
DB_SSLMODE=require

# ---------------------------------------------------------------------------------------------------------------------
# Sesi, cache, dan antrean (semuanya di PostgreSQL agar server aplikasi tidak menyimpan keadaan)
# ---------------------------------------------------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log

# ---------------------------------------------------------------------------------------------------------------------
# Surel keluar (undangan, pengingat, reset kata sandi)
# ---------------------------------------------------------------------------------------------------------------------
# DigitalOcean memblokir port SMTP 25, 465, dan 587 dari Droplet secara bawaan. Pilih penyedia surel yang
# menyediakan port lain (misalnya 2525) atau minta pembukaan blokir kepada DigitalOcean, lalu uji pengiriman.
# Lokasi server penyedia surel termasuk lokasi pemrosesan data pribadi (alamat surel responden) dan wajib
# dicantumkan pada persetujuan tertulis klien (docs/04).
MAIL_MAILER=smtp
# Isi "smtps" untuk TLS langsung (port 465). Kosongkan untuk STARTTLS (port 587 atau 2525).
MAIL_SCHEME=
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=

# Kata sandi SMTP. RAHASIA.
MAIL_PASSWORD=

# Alamat pengirim, contoh: noreply@nusasafety.co.id. Domain pengirim harus memiliki rekaman SPF dan DKIM.
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=NSCAS

# ---------------------------------------------------------------------------------------------------------------------
# Penyimpanan berkas: DigitalOcean Spaces (kompatibel S3), wilayah sgp1
# ---------------------------------------------------------------------------------------------------------------------
FILESYSTEM_DISK=s3

# Kunci akses Spaces yang dibatasi hanya untuk bucket aplikasi (Read/Write/Delete). RAHASIA.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

AWS_DEFAULT_REGION=sgp1

# Nama bucket privat untuk bukti dan laporan, contoh: nscas-prod-berkas
AWS_BUCKET=

AWS_ENDPOINT=https://sgp1.digitaloceanspaces.com
AWS_USE_PATH_STYLE_ENDPOINT=false

# Kosongkan. Bucket bersifat privat; berkas diakses melalui URL bertanda tangan yang dibuat aplikasi.
AWS_URL=

# ---------------------------------------------------------------------------------------------------------------------
# Administrator pertama
# ---------------------------------------------------------------------------------------------------------------------
# Alamat surel SUPER_ADMIN pertama yang dibuat oleh `php artisan db:seed --force`.
# Tidak ada kata sandi di berkas ini: administrator menetapkan kata sandinya sendiri melalui tautan
# "Lupa kata sandi" di halaman masuk, lalu mengaktifkan verifikasi dua langkah.
SEED_ADMIN_EMAIL=

# ---------------------------------------------------------------------------------------------------------------------
# Catatan
# ---------------------------------------------------------------------------------------------------------------------
# Variabel cadangan (BACKUP_*) tidak ditaruh di berkas ini agar kunci bucket cadangan tidak ikut masuk ke kontainer
# aplikasi. Tempatnya di /opt/nscas/backup.env; lihat deploy/digitalocean/backup.sh dan docs/08 bagian cadangan.
