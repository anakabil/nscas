# Salin berkas ini menjadi .env lalu isi nilainya. Jangan mengomit .env.
# Contoh nilai pengembangan lokal (sesuai docker-compose.yml) ditulis di komentar.

# postgresql://nscas:nscas_dev@localhost:5432/nscas
DATABASE_URL=
# Buat dengan: npx auth secret  atau  openssl rand -base64 32
AUTH_SECRET=
# http://localhost:3000
AUTH_URL=
# Alamat publik untuk tautan di surel dan kode QR. Bila kosong, memakai AUTH_URL.
# https://nscas.nusasafety.co.id
APP_URL=
DATA_ENCRYPTION_KEY=          # 32 byte base64, untuk kolom *Enc dan totpSecretEnc (buat dengan: openssl rand -base64 32)
# http://localhost:9000
S3_ENDPOINT=
# us-east-1 (MinIO menerima nilai apa pun)
S3_REGION=
# nscas-dev
S3_BUCKET=
# nscas
S3_ACCESS_KEY_ID=
# nscas_dev_secret
S3_SECRET_ACCESS_KEY=
# localhost
SMTP_HOST=
# 1025
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="NSCAS Nusa Safety <noreply@nusasafety.co.id>"
APP_TIMEZONE=Asia/Jakarta
# Batas permintaan rute bertoken (/s, /sa, /o, /q) per menit per hash IP. Bawaan 60 (docs/04 bagian 5).
SURVEY_RATE_LIMIT_PER_MINUTE=

# Pengguna SUPER_ADMIN pertama yang dibuat oleh npm run db:seed.
# Kata sandi minimal 12 karakter. Bila surel sudah terdaftar, kata sandi tidak diubah.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Opsional, bawaan "Administrator NSCAS"
SEED_ADMIN_NAME=
