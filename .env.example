# Salin berkas ini menjadi .env. Jangan pernah mengomit .env atau menulis rahasia di berkas ini.
APP_NAME=NSCAS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=nscas
DB_USERNAME=nscas
DB_PASSWORD=

SESSION_DRIVER=database
# Sesi berakhir setelah 30 menit tidak aktif (docs/04 bagian 3).
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# Bukti dan rekaman observasi (fase R5). "local" untuk pengembangan dan Codespaces; "s3" untuk MinIO dari
# docker-compose.yml (lihat komentar di berkas itu) atau DigitalOcean Spaces di produksi (docs/08 bagian 9a).
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Pengembangan: surel ditulis ke log (atau ke Mailpit, MAIL_MAILER=smtp port 1025). Produksi memakai Hostinger Mail,
# lihat deploy/digitalocean/.env.production.example.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="admin@nusasafety.co.id"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=sgp1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Verifikasi dua langkah wajib untuk peran pengelola, asesor, dan administrator klien. Jangan dimatikan di produksi.
NSCAS_ENFORCE_TWO_FACTOR=true
# Lokasi pusat data yang disebut pada teks persetujuan responden (docs/04).
NSCAS_DATA_LOCATION=Singapura
NSCAS_DATA_LOCATION_EN=Singapore
# Alamat proksi tepercaya (penyeimbang beban), dipisah koma; kosongkan bila server menerima koneksi langsung.
TRUSTED_PROXIES=
