# Templat lingkungan produksi NSCAS (docs/08 langkah 8). Salin menjadi .env.production di server, isi seluruh
# nilai, lalu: chmod 600 .env.production. Berkas .env.production tidak pernah dikomit.
# Buat nilai acak dengan: openssl rand -base64 32   (kata sandi: openssl rand -hex 24)

# --- Versi dan skala -----------------------------------------------------------------------------------
# Tag image yang dibangun, misalnya tanggal rilis atau tag git: 2026.11.0
NSCAS_VERSION=
# Jumlah replika aplikasi; 3 selama jendela survei (docs/07 bagian 7).
APP_REPLICAS=3

# --- Domain dan TLS (Caddyfile) ------------------------------------------------------------------------
DOMAIN=nscas.nusasafety.co.id
STORAGE_DOMAIN=berkas.nscas.nusasafety.co.id
ACME_EMAIL=
# Alamat pemantau yang boleh membuka /health, dipisah spasi, format CIDR. Contoh: 203.0.113.10/32
MONITORING_IPS=

# --- PostgreSQL ----------------------------------------------------------------------------------------
POSTGRES_USER=nscas
POSTGRES_PASSWORD=
POSTGRES_DB=nscas
# Koneksi per proses; replika × nilai ini + worker + pg-boss harus di bawah max_connections 150.
DATABASE_POOL_MAX=20

# --- Aplikasi ------------------------------------------------------------------------------------------
AUTH_SECRET=
# 32 byte base64 untuk kolom terenkripsi (kontak responden, rahasia TOTP). SIMPAN SALINANNYA DI PENGELOLA
# KATA SANDI PERUSAHAAN: tanpa kunci ini, kontak terenkripsi dan verifikasi dua langkah tidak dapat dipulihkan.
DATA_ENCRYPTION_KEY=
APP_TIMEZONE=Asia/Jakarta
# Per proses aplikasi dan per hash IP; dengan 3 replika batas efektifnya 3 kali nilai ini (docs/06 R3 dan R4).
SURVEY_RATE_LIMIT_PER_MINUTE=600
# Kosongkan: image sudah memuat Chromium yang sesuai.
PDF_CHROMIUM_EXECUTABLE=

# --- Penyimpanan objek utama (MinIO di server yang sama) ----------------------------------------------
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
S3_REGION=us-east-1
S3_BUCKET=nscas-prod
# Akses khusus aplikasi, dibuat minio-init dengan hak hanya pada S3_BUCKET.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Kosong untuk MinIO tanpa KMS; volume server dienkripsi di tingkat disk (docs/08 langkah 1).
S3_SSE=

# --- Surel (SMTP berlokasi di Indonesia) --------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="NSCAS Nusa Safety <noreply@nusasafety.co.id>"

# --- SUPER_ADMIN pertama (hanya untuk seed; hapus kata sandinya dari berkas ini setelah seed) ---------
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME="Administrator NSCAS"

# --- Cadangan ke penyimpanan objek kedua (ops/backup, docs/08 langkah 12) -----------------------------
# Penyedia berbeda dari server aplikasi, berlokasi di Indonesia, dengan enkripsi sisi server aktif.
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_BUCKET=nscas-backup
# Kunci publik age (diawali age1...). Kunci privatnya TIDAK disimpan di server.
BACKUP_AGE_RECIPIENT=
BACKUP_RETENTION_DAYS=30
# Salin juga berkas bukti dan rekaman dari MinIO (mirror; berkas yang dimusnahkan ikut terhapus).
BACKUP_MIRROR_OBJECTS=true
