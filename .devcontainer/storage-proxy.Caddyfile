# Proksi MinIO untuk Codespaces (docker-compose.codespaces.yml): Host dikembalikan ke alamat publik agar tanda
# tangan URL unggah dan unduh tetap sah.
{
	admin off
	auto_https off
}

:9100 {
	reverse_proxy minio:9000 {
		header_up Host {$STORAGE_PUBLIC_HOST}
		header_up X-Forwarded-Host {$STORAGE_PUBLIC_HOST}
	}
}
