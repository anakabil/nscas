includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 5
    paths:
        - app/
    tmpDir: storage/framework/phpstan
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        # array_values dipakai sengaja agar keluaran JSON selalu berupa larik berurutan, juga bila sumbernya kelak
        # berubah; tidak mengubah perilaku.
        - identifier: arrayValues.list
        - identifier: arrayValues.empty
        # Mesin penilaian murni memeriksa bentuk masukan secara defensif walaupun docblock sudah menyebut tipenya,
        # karena masukan berasal dari snapshot JSON. Kode ini dijaga fixture 1e-6 sehingga tidak diubah demi analisis.
        -
            identifier: function.alreadyNarrowedType
            paths:
                - app/Domain/Scoring/DataQuality.php
                - app/Domain/Scoring/SampleCalculator.php
        -
            identifier: notIdentical.alwaysTrue
            path: app/Domain/Scoring/ScoringEngine.php
        # Data contoh pengembangan: PHPStan menyempitkan tipe larik literal terlalu jauh.
        -
            identifiers:
                - identical.alwaysFalse
                - booleanAnd.alwaysFalse
            path: app/Console/Commands/DemoDataCommand.php
